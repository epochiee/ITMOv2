{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent-4b",
  "small_model": "ollama/itmo-agent-4b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local (WSL)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent-4b": {
          "name": "ITMO local qwen3.5:4b (Q4_K_M, 8k ctx) - TEST",
          "limit": {
            "context": 8192,
            "output": 1024
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant for the demo/ service",
      "mode": "primary",
      "prompt": "{file:./system.txt}",
      "steps": 12,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
