      "webhookId": "82ba3d579b2452f4bbfb5b238d47d669"
    },
    {
      "parameters": {
        "jsCode": "const githubBase = event => 'https://api.github.com/repos/' + event.repository.full_name.split('/').map(encodeURIComponent).join('/')\nconst event = $input.first().json.body ?? $input.first().json;\nif (event.action !== 'opened' || !event.issue || event.issue.pull_request) return [];\nif (event.repository?.full_name?.toLowerCase() !== \"epochiee/eve-industry-planner\") return [];\nconst issue = event.issue;\nreturn [{ json: { title: issue.title, body: issue.body ?? '', number: issue.number, base: githubBase(event) } }];"
      },
      "id": "097938d8-560f-5ef1-7b82-004ab7887755",
      "name": "Только issues.opened",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "SET_CLASSIFIER_WORKFLOW_ID",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "title": "={{ $json.title }}",
            "body": "={{ $json.body }}"
          },
          "schema": [
            {
              "id": "title",
              "displayName": "title",
              "type": "string",
              "display": true
            },
            {
              "id": "body",
              "displayName": "body",
              "type": "string",
              "display": true
            }
          ]
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
