      "id": "0c2d5de8-4cfb-b3bd-99a2-91a72edc02da",
      "name": "Вызвать классификатор",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function normalizeClassification(result) {\n  const types = ['bug', 'task', 'feature'];\n  const confidence = typeof result.confidence === 'number' && Number.isFinite(result.confidence)\n    && result.confidence >= 0 && result.confidence <= 1 ? result.confidence : 0;\n  const type = types.includes(result.type) ? result.type : 'unknown';\n  return {\n    type, confidence,\n    route: type === 'unknown' || confidence < 0.8 ? 'unknown' : type,\n  };\n}\nconst result = normalizeClassification($input.first().json);\nreturn [{json:{ ...$(\"Только issues.opened\").first().json, ...result }}];"
      },
