    {
      "parameters": {
        "jsCode": "function reviewEvent(event) {\n  if (event.action === 'opened' && event.pull_request)\n    return { pr: event.pull_request, mode: 'opening' };\n  if (event.action !== 'created' || !event.issue?.pull_request || !event.comment\n      || event.comment.user?.type === 'Bot') return;\n  if (!['OWNER', 'MEMBER', 'COLLABORATOR'].includes(event.comment.author_association)) return;\n  const command = (event.comment.body ?? '').trim();\n  if (command === '/make_ai_review') return { pr: event.issue, mode: 'main' };\n  if (command === '/make_other_ai_review') return { pr: event.issue, mode: 'other' };\n}\nconst githubBase = event => 'https://api.github.com/repos/' + event.repository.full_name.split('/').map(encodeURIComponent).join('/');\nconst event = $input.first().json.body ?? $input.first().json;\nif (event.repository?.full_name?.toLowerCase() !== \"epochiee/eve-industry-planner\") return [];\nconst selected = reviewEvent(event);\nif (!selected) return [];\nreturn [{ json: {\n  base: githubBase(event), number: selected.pr.number,\n  key: String(event.repository.id) + ':' + selected.pr.number,\n  mode: selected.mode,\n} }];"
      },
