    {
      "parameters": {
        "jsCode": "function structured(data) {\n  let value = data.output ?? data.text ?? data;\n  if (typeof value === 'string')\n    value = JSON.parse(value.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, ''));\n  return value;\n}\nfunction formatReview(hunks, skipped, response, commit) {\n  const notes = new Map();\n  for (const item of response.comments ?? []) {\n    if (Number.isInteger(item.id) && typeof item.note === 'string' && !notes.has(item.id))\n      notes.set(item.id, item.note.trim().slice(0, 1600));\n  }\n  const safe = (line) => line.replace(/@/g, '＠').replace(/</g, '‹').replace(/>/g, '›');\n  const summary = safe(String(response.summary ?? '').trim().slice(0, 3500));\n  return {\n    commit_id: commit,\n    event: 'COMMENT',\n    body: (summary || 'Автоматическое ревью изменений.') +\n      (skipped.length ? '\\n\\nФайлы без доступного текстового diff: ' + skipped.map(safe).join(', ') : ''),\n    comments: hunks.map(h => ({\n      path: h.path, ...h.anchor,\n      body: notes.get(h.id) ? safe(notes.get(h.id)) : 'Модель не оставила отдельного замечания к этому блоку.',\n    })),\n  };\n}\nconst prepared = $(\"Разбить diff на блоки\").first().json;\nconst result = structured($input.first().json);\nconst model = prepared.mode === 'other' ? \"qwen/qwen3.7-max\" : \"openai/gpt-5\";\nconst review = formatReview(prepared.hunks, prepared.skipped, result, prepared.head);\nreview.body = '**Модель: ' + model + '**\\n\\n' + review.body;\nreturn [{ json: { ...prepared, review, model } }];"
      },
