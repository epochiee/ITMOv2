    {
      "parameters": {
        "jsCode": "function parseHunks(files) {\n  const hunks = [];\n  const skipped = [];\n  for (const file of files) {\n    const lines = file.patch?.split(/\\r?\\n/) ?? [];\n    const firstBlock = hunks.length;\n    let block;\n    let left;\n    let right;\n    let endLeft;\n    let endRight;\n    function finish() {\n      if (!block) return;\n      if (!block.anchor) throw new Error('Блок без изменённой строки: ' + file.filename);\n      if (left !== endLeft || right !== endRight) throw new Error('Неполный блок diff: ' + file.filename);\n      hunks.push(block);\n      block = undefined;\n    }\n    for (const line of lines) {\n      const match = /^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@/.exec(line);\n      if (match) {\n        finish();\n        left = Number(match[1]);\n        right = Number(match[3]);\n        endLeft = left + Number(match[2] ?? 1);\n        endRight = right + Number(match[4] ?? 1);\n        block = { id: hunks.length + 1, path: file.filename, diff: line, anchor: null };\n        continue;\n      }\n      if (!block) continue;\n      block.diff += '\\n' + line;\n      if (line.startsWith('+')) {\n        if (block.anchor?.side !== 'RIGHT') block.anchor = { line: right, side: 'RIGHT' };\n        right++;\n      } else if (line.startsWith('-')) {\n        block.anchor ??= { line: left, side: 'LEFT' };\n        left++;\n      } else if (line.startsWith(' ')) {\n        left++;\n        right++;\n      }\n    }\n    finish();\n    if (firstBlock === hunks.length) skipped.push(file.filename);\n  }\n  return { hunks, skipped };\n}\nconst pages = $input.all().flatMap(x => Array.isArray(x.json.body) ? x.json.body : [x.json.body]);\nconst pr = $(\"Получить PR и commit SHA\").first().json;\nif (pages.some(x => !x?.filename) || pages.length !== pr.changed_files)\n  throw new Error('GitHub вернул неполный список файлов PR');\nconst { hunks, skipped } = parseHunks(pages);\nif (!hunks.length) throw new Error('В PR нет доступных текстовых блоков для ревью');\nconst payload = JSON.stringify(hunks.map(({ id, path, diff }) => ({ id, path, diff })));\nif (payload.length > 52000 || hunks.length > 40)\n  throw new Error('Для ревью выберите тестовый PR с максимум 40 текстовыми блоками и кратким diff');\nreturn [{ json: { ...$(\"Команда или открытие PR\").first().json, hunks, skipped, payload, head: pr.head.sha, prId: String(pr.id) } }];"
      },
